TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Your Telegram numeric user id (get it via /whoami after starting the bot once)
TELEGRAM_ALLOWED_USER_ID=

# Optional — vision for meal photos + package/nutrition labels
