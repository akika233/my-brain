# Copy to career/.env and fill in. Never share career/.env

# local | bosuka (Selenium DocStore) | nf (alias of bosuka)
DOCSTORE_MODE=bosuka

# Download / read folder
INVOICE_DOWNLOAD_DIR=C:\Users\shjiang\OneDrive - New Balance Athletics, Inc\Documents\Invoice

# --- bosuka DocStore (Selenium + basic auth) ---
# Host must be reachable (VPN / office network). Chrome required.
DOCSTORE_BASE_URL=http://bosuka1.newbalance.com:6400
# Country code becomes the store name: "NG Docstore", "NF Docstore", ...
DOCSTORE_COUNTRY=NG
DOCSTORE_LREFS=221566,223663
DOCSTORE_USERNAME=your.user
DOCSTORE_PASSWORD=your-password
# 1 = headless Chrome, 0 = show the browser window
DOCSTORE_HEADLESS=1
