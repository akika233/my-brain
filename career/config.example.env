# Copy to career/.env and fill in. Never commit career/.env

# local | bosuka (Selenium DocStore) | nf (alias of bosuka)
DOCSTORE_MODE=bosuka

# Download / read folder (work laptop path)
INVOICE_DOWNLOAD_DIR=C:\Users\shjiang\OneDrive - New Balance Athletics, Inc\Documents\Invoice

# --- bosuka DocStore (Selenium + basic auth) ---
# Host must be reachable (VPN / office network). Chrome required.
DOCSTORE_BASE_URL=http://bosuka1.newbalance.com:6400
# Country code becomes the store name: "NG Docstore", "NF Docstore", ...
DOCSTORE_COUNTRY=NG
DOCSTORE_LREFS=221566,223663
DOCSTORE_USERNAME=your.user
DOCSTORE_PASSWORD=your-password
# 1 = headless Chrome, 0 = show the browser window
DOCSTORE_HEADLESS=1

# --- Adyen scheduled report download (career/adyen_reports) ---
# live | test
ADYEN_ENVIRONMENT=live
# MerchantAccount | Company
ADYEN_REPORT_SCOPE=MerchantAccount
# Merchant or company account name exactly as shown in the CA report-download URL
ADYEN_ACCOUNT_NAME=YourMerchantAccount
# Filename prefix, e.g. payments_accounting_report, settlement_detail_report
ADYEN_REPORT_TYPE=payments_accounting_report
ADYEN_REPORT_EXTENSION=csv
# Report user created in Customer Area > Developers > Users (or API credentials),
# with the "Report" / "BalancePlatform Report Download" role. Password/basic-auth
# is set under that user's settings, NOT your regular API key.
ADYEN_REPORT_USERNAME=report@Company.YourCompanyAccount
ADYEN_REPORT_PASSWORD=your-report-password
# Where downloaded reports are saved (point this at a synced SharePoint/OneDrive
# folder once you have one; a local folder works fine to start)
ADYEN_REPORT_DOWNLOAD_DIR=career/adyen_reports/downloads
